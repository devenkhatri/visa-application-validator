# AI — single key for all LLM calls via OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Model overrides (optional — defaults set in lib/ai/openrouter.ts)
MODEL_OCR=google/gemma-4-26b-it:free
MODEL_ANALYSIS=deepseek/deepseek-r1:free

# App
NEXT_PUBLIC_URL=http://localhost:3000
DEMO_MODE=true

# SQLite DB path (optional — defaults to ./data/visa-mvp.db)
# SQLITE_DB_PATH=./data/visa-mvp.db
